# Maintainer: Your Name <your.email@example.com>
pkgname=linux-samsung-a04e
pkgver=4.19.325
pkgrel=0
pkgdesc="Samsung Galaxy A04e postmarketOS kernel downstream port"
arch="aarch64"
url="https://github.com"
license="GPL-2.0-only"
options="!strip !check !debug"

_carch="arm64"
_config="config-samsung-a04e.${arch}"

# PROVIDE REPO URL: Replace with your actual kernel source URL and branch name
url="https://github.com/pp665687/linux-samsung-a04e-postmarketos-kernel"
_repo_url="https://github.com/pp665687/linux-samsung-a04e-postmarketos-kernel"
_branch="main"

source="
	$_config
	$pkgname-$pkgver::git+$_repo_url#branch=$_branch
"

build() {
	export ARCH="arm64"
	export CC="clang"
	export CLANG_TRIPLE="aarch64-none-linux-gnu-"
	export CROSS_COMPILE="aarch64-none-linux-gnu-"

	# Move into the dynamically downloaded source code folder
	cd "$srcdir/$pkgname-$pkgver"

	# Inject configuration file
	cp "$srcdir/$_config" .config

	make olddefconfig
	make -j$(nproc) Image.gz
}

package() {
	cd "$srcdir/$pkgname-$pkgver"
	mkdir -p "$pkgdir"/boot
	cp arch/arm64/boot/Image.gz "$pkgdir"/boot/vmlinuz
}

sha512sums="
# Handled automatically by the workflow run
"

